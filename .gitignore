# 依赖
node_modules/

# 构建产物
dist/
dist-mobile/
dist-apk/
android/build/
*.idsig

# WebView 内联资源：由 scripts/build-standalone.mjs 生成（index.html + 语音副本）
android/app/assets/www/

# 临时脚本产物
.tmp/
*.local
.DS_Store

# 签名证书：不入库（公开仓库尤其不能放）。
# 首次构建会自动生成 android/keystore/xiangqi.jks；要发布到商店请换成正式证书，
# 并用环境变量 XQ_KEYSTORE / XQ_KEYSTORE_PASS 指定路径与口令。
android/keystore/
*.jks
*.keystore
